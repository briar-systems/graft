# the secret bridge: laurel's secret source over hedge's secrets for hosted code
#
# a laurel application borrows a secret by name through `laurel.secret`, and
# the bridge borrows it from hedge under the same name, out of the grants the
# configuration gives the application. hedge copies the secret into secret
# storage, hands it to the application's use for that one call and clears it,
# so the value stays secret-typed from hedge's store to the application's use
# and never passes through the bridge. hedge's statuses are laurel's one to one.

use hedge_secret: hedge.secret;
use hedge.service;
use laurel.secret;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

# caller-owned bridge state. it stays where it is made from `make` until
# `close` answers true
pub rec Secrets {
    # the application hedge lends the secrets of, once `bind` has named it
    source: hedge_secret.Source;
    # laurel's name for this bridge's resolver
    laurel: secret.Source;
    slot:   usize;
    bound:  bool;
    valid:  bool;
}

# a resolver is secret welded through its callback type, so it never erases to
# ptr: it lives in this table, and its ctx is its slot
var resolvers:        [secret.MAX_RESOLVERS]secret.Resolver;
var resolver_used:    [secret.MAX_RESOLVERS]bool;
var resolver_bridges: [secret.MAX_RESOLVERS]*Secrets;
var resolver_lock:    mutex.Mutex = 0;

fun bridge_of(slot: usize) *Secrets {
    mutex.lock(?resolver_lock);
    var bridge: *Secrets = nil;
    if (slot < secret.MAX_RESOLVERS && resolver_used[slot]) { bridge = resolver_bridges[slot]; }
    mutex.unlock(?resolver_lock);
    ret bridge;
}

fun status(value: hedge_secret.Borrow) secret.Status {
    if (value == hedge_secret.BORROW_OK)      { ret secret.BORROW_OK; }
    if (value == hedge_secret.BORROW_MISSING) { ret secret.BORROW_MISSING; }
    if (value == hedge_secret.BORROW_REFUSED) { ret secret.BORROW_REFUSED; }
    ret secret.BORROW_INVALID;
}

# a borrow before `bind`, or after the bridge has closed, is invalid
fun borrow(ctx: ptr, name: view.View, use: secret.UseFun, use_ctx: ptr) secret.Status {
    val bridge: *Secrets = bridge_of(ctx::usize);
    if (bridge == nil || !bridge.bound) { ret secret.BORROW_INVALID; }
    ret status(hedge_secret.borrow(bridge.source, name, use, use_ctx));
}

# makes the bridge and registers its resolver with laurel
# ---
# bridge: storage for the bridge, which stays in place until `close`
# ret:    whether it was made. laurel holds at most `secret.MAX_RESOLVERS`
pub fun make(bridge: *Secrets) bool {
    if (bridge == nil) { ret false; }
    bridge.valid = false;
    bridge.bound = false;
    mutex.lock(?resolver_lock);
    var slot: usize = 0;
    for (slot < secret.MAX_RESOLVERS && resolver_used[slot]) { slot = slot + 1; }
    if (slot == secret.MAX_RESOLVERS) {
        mutex.unlock(?resolver_lock);
        ret false;
    }
    resolver_used[slot]    = true;
    resolver_bridges[slot] = bridge;
    resolvers[slot]        = secret.Resolver{ctx: slot::ptr, borrow: borrow};
    mutex.unlock(?resolver_lock);
    if (!secret.register(?resolvers[slot], ?bridge.laurel)) {
        mutex.lock(?resolver_lock);
        resolver_used[slot]    = false;
        resolver_bridges[slot] = nil;
        mutex.unlock(?resolver_lock);
        ret false;
    }
    bridge.slot  = slot;
    bridge.valid = true;
    ret true;
}

# names the registered application `name` as the one whose grants the bridge
# lends. a bridge serves one application, so a second bind is refused
pub fun bind(bridge: *Secrets, registry: *service.Applications, name: str) bool {
    if (bridge == nil || !bridge.valid || bridge.bound)       { ret false; }
    if (!hedge_secret.source(registry, name, ?bridge.source)) { ret false; }
    bridge.bound = true;
    ret true;
}

# laurel's secret source, for an application's provider set under
# `secret.key()`, or nil when the bridge was never made
pub fun source(bridge: *Secrets) *secret.Source {
    if (bridge == nil || !bridge.valid) { ret nil; }
    ret ?bridge.laurel;
}

# unregisters the resolver. refused while a borrow through it is in flight
pub fun close(bridge: *Secrets) bool {
    if (bridge == nil || !bridge.valid)    { ret true; }
    if (!secret.unregister(bridge.laurel)) { ret false; }
    mutex.lock(?resolver_lock);
    resolver_used[bridge.slot]    = false;
    resolver_bridges[bridge.slot] = nil;
    mutex.unlock(?resolver_lock);
    bridge.valid = false;
    bridge.bound = false;
    ret true;
}
