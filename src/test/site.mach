# a laurel application for graft's tests, and what it saw of hedge driving it
#
# typed and wildcard routes, a route whose handler suspends on its body, a
# fallback, one middleware, an error mapper and one lifecycle component, every
# part of it borrowed from the one Site record. the fallback can also use the
# secret, configuration and telemetry providers its host supplies

use crypto.contracts;
use hedge.clock;
use http.core.exchange;
use http.core.message;
use http.core.method;
use http.core.status;
use http_router: http.router.router;
use laurel.app;
use laurel.config;
use laurel.context;
use laurel.error;
use laurel.form;
use laurel.handler;
use laurel.lifecycle;
use laurel.middleware;
use laurel.observability;
use laurel.provider;
use laurel.render;
use laurel.router;
use laurel.secret;
use laurel.security;
use laurel.task;
use A: std.allocator;
use std.chrono.duration;
use std.chrono.time;
use std.crypto.ct;
use std.sync.atomic;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

# what the application saw of its requests. the counters a test waits on while
# the process serves are atomic, and the rest are read once it has stopped
pub rec Probe {
    calls:      usize;
    layers:     usize;
    exits:      usize;
    starts:     i64;
    finishes:   usize;
    errors:     usize;
    mapped:     u16;
    order:      u64;
    file:       [8]u8;
    file_len:   usize;
    route:      [8]u8;
    route_len:  usize;
    status:     u16;
    entries:    i64;
    resumes:    usize;
    work:       usize;
    abandons:   i64;
    settlement: handler.Settlement;
    outcome:    observability.Outcome;
    field_len:  usize;
    value:      [16]u8;
    value_len:  usize;
    request_id: usize;
    provided:   *Provided;
}

# the secret the configuration grants the site as `token`
pub val SECRET: str = "s3cret";

# what the fallback read through the providers its host supplies, each time it
# ran with `enabled` set
pub rec Provided {
    enabled:    bool;
    providers:  *provider.Set;
    vocabulary: *observability.Vocabulary;
    # the setting `greeting`
    setting:     [16]u8;
    setting_len: usize;
    read:        config.Status;
    # the borrow of the secret `token`, and whether it held SECRET
    borrowed: secret.Status;
    matched:  bool;
    # the times the fallback used them
    uses: i64;
}

fun resolved(set: *provider.Set, key: view.View) ptr {
    val found: res[ptr, view.View] = provider.resolve(set, key);
    if (sel found.err) { ret nil; }
    ret found.ok;
}

fun use_token(owner: ptr, value: contracts.SecretBytes) bool {
    val provided: *Provided = owner::*Provided;
    var expected: [6]^u8;
    var i:        usize     = 0;
    for (i < 6) {
        expected[i] = SECRET[i];
        i           = i + 1;
    }
    ct.begin();
    val equal: ^u8 = ct.eq_bytes(value.data, ?expected[0], 6);
    provided.matched = value.len == 6 && equal:>u8 == 1;
    ct.end();
    ret provided.matched;
}

fun signal(telemetry: *observability.Telemetry, vocabulary: *observability.Vocabulary,
    kind: observability.SignalKind, name: str, value: i64) {
    var emitted: observability.Signal;
    if (observability.init_signal(?emitted, vocabulary, kind, text(name), value)
        == observability.RECORD_OK) {
        observability.emit(telemetry, ?emitted);
    }
}

# reads the setting, borrows the secret, counts three orders and logs one
fun use_providers(provided: *Provided) {
    val settings: *config.Provider = resolved(provided.providers, config.key())::*config.Provider;
    if (settings != nil) {
        val found: config.Read = config.read(settings, text("greeting"), ?provided.setting[0],
            16);
        provided.read        = found.status;
        provided.setting_len = found.len;
    }
    val secrets: *secret.Source = resolved(provided.providers, secret.key())::*secret.Source;
    if (secrets != nil) {
        provided.borrowed = secret.borrow(@secrets, text("token"), use_token, provided::ptr);
    }
    val telemetry: *observability.Telemetry = resolved(provided.providers,
        observability.telemetry_key())::*observability.Telemetry;
    if (telemetry != nil) {
        signal(telemetry, provided.vocabulary, observability.SIGNAL_COUNTER, "orders_total", 3);
        signal(telemetry, provided.vocabulary, observability.SIGNAL_EVENT, "order_placed", 42);
    }
    atomic.fetch_add(?provided.uses, 1);
}

# how long the task's run keeps going once drain has cancelled it
pub val WORK_HOLD_NS: u64 = 150000000;

# the site's one background task, registered when the application starts. its
# run publishes a snapshot and then keeps going until drain cancels it, and
# for WORK_HOLD_NS after, so the drain has a run in flight to wait for
pub rec Work {
    enabled:   bool;
    providers: *provider.Set;
    tasks:     *task.Provider;
    handle:    task.Handle;
    spec:      task.Spec;
    slots:     [16]u8;
    steps:     i64;
    # when the run first saw its scope cancelled, on hedge's monotonic clock
    cancelled_ns: u64;
    finished:     i64;
}

fun work_step(state: ptr, run: *task.Run) res[task.StepStatus, view.View] {
    val work: *Work = state::*Work;
    if (atomic.fetch_add(?work.steps, 1) == 0
        && task.publish(run, view.view("tick"::*char, 4)) != task.STATUS_OK) {
        ret res[task.StepStatus, view.View].err{view.view("publish refused"::*char, 15)};
    }
    val reason: cancel.Reason = cancel.reason(run.scope);
    if (!(sel reason.cancelled)) { ret res[task.StepStatus, view.View].ok{task.STEP_PENDING}; }
    val now: u64 = clock.monotonic_ns();
    if (work.cancelled_ns == 0) { work.cancelled_ns = now; }
    if (now - work.cancelled_ns < WORK_HOLD_NS) {
        ret res[task.StepStatus, view.View].ok{task.STEP_PENDING};
    }
    atomic.store(?work.finished, 1);
    ret res[task.StepStatus, view.View].ok{task.STEP_DONE};
}

# register the task through the provider the host supplies, and run it now
fun start_work(work: *Work) bool {
    work.tasks = task.resolve(work.providers);
    if (work.tasks == nil) { ret false; }
    work.spec = task.Spec{name: view.view("work"::*char, 4), state: work::ptr, step: work_step,
        period: opt[duration.Duration].none{}, run_timeout: opt[duration.Duration].none{},
        slots:  ?work.slots[0], slot_bytes: 8, slot_count: 2};
    ret task.register(work.tasks, ?work.spec, ?work.handle) == task.STATUS_OK
        && task.trigger(work.tasks, work.handle) == task.STATUS_OK;
}

# the site's one lifecycle component, driven from the supervisor's thread
pub rec Phases {
    probe: *Probe;
    # readiness answers not ready this many times before it answers ready
    not_ready: usize;
    # drain never finishes
    stuck:    bool;
    starts:   i64;
    readies:  i64;
    drains:   i64;
    stops:    i64;
    drained:  bool;
    releases: i64;
    # requests the application had seen when it was started
    requests_at_start: i64;
    drained_at_stop:   bool;
    work:              *Work;
    # whether the task's run had finished when the application was stopped
    worked_at_stop: bool;
}

fun phase_start(owner: ptr) res[lifecycle.CallbackStatus, view.View] {
    val phases: *Phases = owner::*Phases;
    phases.requests_at_start = atomic.load(?phases.probe.starts);
    atomic.fetch_add(?phases.starts, 1);
    if (phases.work.enabled && !start_work(phases.work)) {
        ret res[lifecycle.CallbackStatus, view.View].err{view.view("task refused"::*char, 12)};
    }
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun phase_ready(owner: ptr) lifecycle.Readiness {
    val phases: *Phases = owner::*Phases;
    atomic.fetch_add(?phases.readies, 1);
    if (phases.not_ready != 0) {
        phases.not_ready = phases.not_ready - 1;
        ret lifecycle.NOT_READY;
    }
    ret lifecycle.READY_NOW;
}

fun phase_drain(owner: ptr, deadline: opt[time.Instant])
    res[lifecycle.CallbackStatus, view.View] {
    val phases: *Phases = owner::*Phases;
    atomic.fetch_add(?phases.drains, 1);
    if (phases.stuck) {
        ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_PENDING};
    }
    phases.drained = true;
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun phase_stop(owner: ptr) res[lifecycle.CallbackStatus, view.View] {
    val phases: *Phases = owner::*Phases;
    phases.drained_at_stop = phases.drained;
    phases.worked_at_stop  = atomic.load(?phases.work.finished) == 1;
    atomic.fetch_add(?phases.stops, 1);
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun copy_text(source: view.View, output: *u8, capacity: usize) usize {
    var i: usize = 0;
    for (i < source.len && i < capacity) {
        output[i] = source.data[i];
        i         = i + 1;
    }
    ret i;
}

pub fun same_text(value: *u8, length: usize, expected: str) bool {
    var i: usize = 0;
    for (i < length) {
        if (expected[i] == 0 || value[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret expected[length] == 0;
}

pub fun text(value: str) view.View {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    ret view.view(value::*char, length);
}

# laurel's own request events, which run alongside hedge's log
fun probe_event_start(owner: ptr, event: *observability.RequestEvent) {
    val state: *Probe = owner::*Probe;
    atomic.fetch_add(?state.starts, 1);
    state.route_len = copy_text(observability.event_route_name(event),
        ?state.route[0], 8);
    state.request_id = event.request_id_len;
}

fun probe_event_finish(owner: ptr, event: *observability.RequestEvent) {
    val state: *Probe = owner::*Probe;
    state.finishes = state.finishes + 1;
    state.outcome  = event.outcome;
    state.status   = event.status;
}

fun probe_event_error(owner: ptr, event: *observability.RequestEvent,
    failure: error.AppError) {
    val state: *Probe = owner::*Probe;
    state.errors  = state.errors + 1;
    state.outcome = event.outcome;
}

fun probe_failure(detail: str) handler.Result {
    ret handler.fail(error.make(error.INTERNAL, 500,
        "internal server error", detail, false));
}

fun probe_respond(request_context: *context.Context,
    code: status.Status) handler.Result {
    if (message.set_status(context.response(request_context), code)
        != message.RESPONSE_OK) {
        ret probe_failure("probe could not set a status");
    }
    ret handler.respond();
}

# the fallback sets its status through laurel's own context, so the response a
# client reads was produced by the framework, not by the bridge
fun probe_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe = owner::*Probe;
    @state      = nil;
    probe.calls = probe.calls + 1;
    if (probe.provided.enabled) { use_providers(probe.provided); }
    ret probe_respond(request_context, status.ACCEPTED);
}

fun order_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe         = owner::*Probe;
    val id:    *context.Param = context.find_param(request_context, text("id"));
    @state = nil;
    if (id == nil || id.kind != context.PARAM_U64) {
        ret probe_failure("order id was not decoded");
    }
    probe.order = id.unsigned_value;
    ret probe_respond(request_context, status.OK);
}

fun file_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe         = owner::*Probe;
    val rest:  *context.Param = context.find_param(request_context, text("path"));
    @state = nil;
    if (rest == nil || rest.kind != context.PARAM_TEXT) {
        ret probe_failure("wildcard path was not captured");
    }
    probe.file_len = copy_text(rest.value, ?probe.file[0], 8);
    ret probe_respond(request_context, status.OK);
}

# the form handler's per-request state, allocated from the request arena so it
# survives however many suspensions the body takes to arrive
rec FormState {
    decoder: form.UrlEncoded;
    parser:  form.BodyParser;
    fixed:   render.Fixed;
    fields:  [8]form.Field;
    bytes:   [256]u8;
    buffer:  [64]u8;
}

# the decoded value is echoed back, so the client reads the proof that the body
# was assembled by one handler however it arrived
fun respond_with_value(request_context: *context.Context, work: *FormState,
    value: view.View) handler.Result {
    val response: *message.Response  = context.response(request_context);
    val bound:    *exchange.Exchange = context.exchange_ref(request_context);
    if (response == nil || bound == nil) {
        ret probe_failure("the request context has no exchange");
    }
    if (message.set_status(response, status.OK) != message.RESPONSE_OK) {
        ret probe_failure("probe could not set a status");
    }
    if (!render.init_fixed(?work.fixed, value, bound.generation, bound.limits,
        ?response.trailers, request_context.scope)) {
        ret probe_failure("fixed response body would not initialize");
    }
    if (message.set_body_reader(response, render.fixed_body(?work.fixed),
        bound.limits) != message.RESPONSE_OK) {
        ret probe_failure("response body was refused");
    }
    ret handler.respond();
}

fun form_limits() form.Limits {
    ret form.Limits{max_bytes: 256, max_fields: 8, max_name_bytes: 32,
        max_value_bytes: 64, max_temporary_bytes: 256};
}

# one pass over whatever the body has so far: a pending read suspends the whole
# chain, and the work below it runs once, when the body is complete
fun drive_form(probe: *Probe, request_context: *context.Context,
    work: *FormState, first: form.Operation) handler.Result {
    var current: form.Operation = first;
    for {
        if (current.status == form.PENDING)  { ret handler.suspend(current.token); }
        if (current.status == form.COMPLETE) { brk; }
        if (current.status != form.MORE)     { ret handler.fail(current.app_error); }
        current = form.poll_body(?work.parser);
    }
    probe.work      = probe.work + 1;
    probe.field_len = current.form.len;
    if (current.form.len == 0) { ret probe_respond(request_context, status.OK); }
    probe.value_len = copy_text(current.form.fields[0].value, ?probe.value[0], 16);
    ret respond_with_value(request_context, work, current.form.fields[0].value);
}

fun form_handler(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe = owner::*Probe;
    atomic.fetch_add(?probe.entries, 1);
    val allocated: res[*FormState, A.Error] =
        A.zallocate[FormState](request_context.alloc, 1);
    if (sel allocated.err) { ret probe_failure("form state allocation failed"); }
    val work: *FormState = allocated.ok;
    @state = work::ptr;
    if (!form.init_urlencoded(?work.decoder, form.Storage{
        fields:        ?work.fields[0], field_capacity: 8, bytes: ?work.bytes[0],
        byte_capacity: 256
    }, form_limits())) {
        ret probe_failure("form decoder would not initialize");
    }
    if (!form.init_body(?work.parser, ?work.decoder,
        context.request(request_context).body, ?work.buffer[0], 64)) {
        ret probe_failure("form body parser would not initialize");
    }
    ret drive_form(probe, request_context, work,
        form.poll_body(?work.parser));
}

fun form_resume(owner: ptr, request_context: *context.Context, state: ptr,
    settlement: handler.Settlement, token: u64) handler.Result {
    val probe: *Probe     = owner::*Probe;
    val work:  *FormState = state::*FormState;
    probe.resumes    = probe.resumes + 1;
    probe.settlement = settlement;
    if (work == nil) { ret probe_failure("form state did not survive"); }
    if (settlement == handler.SETTLE_ABANDONED) {
        atomic.fetch_add(?probe.abandons, 1);
        ret handler.respond();
    }
    ret drive_form(probe, request_context, work,
        form.complete_body(?work.parser, token));
}

fun probe_before(owner: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val probe: *Probe = owner::*Probe;
    @state       = nil;
    probe.layers = probe.layers + 1;
    ret handler.proceed();
}

fun probe_after(owner: ptr, request_context: *context.Context, state: ptr,
    carried: handler.Result) handler.Result {
    val probe: *Probe = owner::*Probe;
    probe.exits = probe.exits + 1;
    ret carried;
}

fun probe_error(owner: ptr, failure: error.AppError,
    request_context: *context.Context) res[u8, error.RenderFailure] {
    val state: *Probe = owner::*Probe;
    state.mapped = failure.status;
    if (message.set_status(context.response(request_context), failure.status)
        != message.RESPONSE_OK) {
        ret res[u8, error.RenderFailure].err{
            error.render_failure("probe could not render an error")
        };
    }
    ret res[u8, error.RenderFailure].ok{1};
}

pub rec Site {
    probe:          Probe;
    parameters:     [2]router.Parameter;
    routes:         [3]router.Route;
    specifications: [3]http_router.Route;
    compiled:       [3]http_router.CompiledRoute;
    segments:       [12]http_router.Segment;
    router:         router.Router;
    layers:         [1]middleware.Middleware;
    middlewares:    middleware.Stack;
    host:           [1]provider.Provider;
    providers:      provider.Set;
    work:           Work;
    provided:       Provided;
    phases:         Phases;
    component:      lifecycle.Lifecycle;
    controller:     lifecycle.Controller;
    headers:        security.HeadersPolicy;
    observer:       observability.Observer;
    vocabulary:     observability.Vocabulary;
    application:    app.App;
}

# the site assembled and not yet started, since the host drives its lifecycle.
# `not_ready`, `stuck`, the handler deadline, whether it runs its task and
# whether its fallback uses its providers are the test's to choose. `host` is
# the provider entry its host supplies
pub fun assemble_site(site: *Site, host: provider.Provider, not_ready: usize, stuck: bool,
    handler_timeout: opt[duration.Duration], work: bool, provided: bool) bool {
    site.host[0] = host;
    if (!provider.init(?site.providers, ?site.host[0], 1, 1, 32)) { ret false; }
    site.work.enabled   = work;
    site.work.providers = ?site.providers;
    site.provided       = Provided{enabled: provided, providers: ?site.providers,
        vocabulary: ?site.vocabulary, setting_len: 0, read: 0, borrowed: 0, matched: false,
        uses:       0};
    site.probe.provided = ?site.provided;
    site.phases         = Phases{probe: ?site.probe, not_ready: not_ready, stuck: stuck,
        starts:            0, readies: 0, drains: 0, stops: 0, drained: false, releases: 0,
        requests_at_start: 0, drained_at_stop: false, work: ?site.work, worked_at_stop: false};
    site.component = lifecycle.Lifecycle{ctx: ?site.phases, start: phase_start,
        ready: phase_ready, drain: phase_drain, stop: phase_stop};
    if (!lifecycle.init(?site.controller, ?site.component, 1, 1)) { ret false; }
    site.parameters[0] = router.Parameter{name: text("id"), wildcard: false,
        decoder: router.u64_decoder()};
    site.parameters[1] = router.Parameter{name: text("path"), wildcard: true,
        decoder: router.text_decoder()};
    site.routes[0] = router.Route{
        method:  router.exact_method(method.from_kind(method.GET)),
        host:    router.any_host(), path: router.path(text("/orders/:id")),
        name:    "order", parameters: ?site.parameters[0], parameter_len: 1,
        handler: handler.Handler{ctx: ?site.probe, call: order_handler,
            resume: nil}
    };
    site.routes[1] = router.Route{
        method:     router.any_method(), host: router.any_host(),
        path:       router.path(text("/files/*path")), name: "file",
        parameters: ?site.parameters[1], parameter_len: 1,
        handler:    handler.Handler{ctx: ?site.probe, call: file_handler,
            resume: nil}
    };
    # the one route that suspends: its body arrives in pieces, and it is entered
    # once however many pieces that takes
    site.routes[2] = router.Route{
        method:     router.any_method(), host: router.any_host(),
        path:       router.path(text("/submit")), name: "form",
        parameters: nil, parameter_len: 0,
        handler:    handler.Handler{ctx: ?site.probe, call: form_handler,
            resume: form_resume}
    };
    val storage: router.Storage = router.Storage{
        specifications:  ?site.specifications[0], specification_cap: 3,
        compiled_routes: ?site.compiled[0], compiled_route_cap: 3,
        segments:        ?site.segments[0], segment_cap: 12
    };
    if (router.compile(?site.router, ?site.routes[0], 3, storage,
        router.limits_default()).status != router.COMPILE_OK) { ret false; }
    site.layers[0] = middleware.Middleware{ctx: ?site.probe, before: probe_before,
        resume: nil, after: probe_after};
    site.middlewares = middleware.Stack{items: ?site.layers[0], len: 1};
    if (!security.secure_headers(?site.headers)) { ret false; }
    site.observer = observability.Observer{ctx: ?site.probe,
        start: probe_event_start, finish: probe_event_finish,
        error: probe_event_error};
    if (!observability.init_vocabulary(?site.vocabulary, nil, 0)) { ret false; }
    val assembly: app.Assembly = app.Assembly{
        config: app.Config{limits: app.Limits{max_body_bytes: 1024,
            max_form_fields:         8, max_upload_bytes: 1024, max_route_params: 4,
            max_request_id_bytes:    64, max_active_requests: 2,
            max_middleware_depth:    8, handler_timeout: handler_timeout,
            max_providers:           1, max_provider_key_bytes: 32,
            max_background_services: 1}, trust_proxy: false,
            panic_policy:            middleware.PANIC_ABORT},
        router:   ?site.router, middleware: ?site.middlewares,
        fallback: handler.Handler{ctx: ?site.probe, call: probe_handler,
            resume: nil},
        errors:       error.Mapper{ctx: ?site.probe, render: probe_error},
        providers:    ?site.providers, lifecycle: ?site.controller, sessions: nil,
        security:     ?site.headers, csrf: nil, origins: nil, authenticator: nil,
        renderer:     nil, observer: ?site.observer, vocabulary: ?site.vocabulary,
        event_policy: observability.policy_default(), app_state: nil
    };
    ret app.assemble(?site.application, assembly);
}

# what the host calls once the process has stopped the application
pub fun release_site(site: *Site) bool {
    atomic.fetch_add(?site.phases.releases, 1);
    ret app.release(?site.application) && lifecycle.destroy(?site.controller);
}
